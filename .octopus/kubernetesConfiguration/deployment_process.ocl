step "create-namespace" {
    name = "Create Namespace"
    properties = {
        Octopus.Action.TargetRoles = "kube-cluster-1,kube-cluster-2"
    }

    action {
        action_type = "Octopus.KubernetesDeployRawYaml"
        properties = {
            Octopus.Action.GitRepository.FilePathFilters = "DevOps\\Kubernetes\\Yaml\\namespace.yml"
            Octopus.Action.GitRepository.Source = "Project"
            Octopus.Action.Kubernetes.DeploymentTimeout = "180"
            Octopus.Action.Kubernetes.ResourceStatusCheck = "True"
            Octopus.Action.Kubernetes.ServerSideApply.Enabled = "False"
            Octopus.Action.Kubernetes.ServerSideApply.ForceConflicts = "False"
            Octopus.Action.KubernetesContainers.CustomResourceYamlFileName = "DevOps\\Kubernetes\\Yaml\\namespace.yml"
            Octopus.Action.Script.ScriptSource = "GitRepository"
        }
    }
}

